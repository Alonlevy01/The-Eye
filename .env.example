# =============================================================================
# The-Eye — Example Environment Configuration (ALL API KEYS EMPTY)
# Copy to `.env` if you want to enable optional VLM tactical coaching.
# Never commit `.env` to Git.
# =============================================================================

# Vision-Language Model:
# - Local Ollama (default, free & private): ollama:qwen3.5:9b
# - OpenRouter vision model: nvidia/nemotron-3.5-super-vl:free
THE_EYE_VLM_MODEL=ollama:qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only required when using an OpenRouter model
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
